#include <iostream>
using namespace std;

class InvalidMarksException {
};

int main() {
    int n, marks[100], total = 0;
    float average;

    cout << "Enter Number of Subjects: ";
    cin >> n;

    if (n <= 0 || n > 100) {
        cout << "Invalid number of subjects";
        return 0;
    }

    try {
        cout << "Enter Marks: ";

        for (int i = 0; i < n; i++) {
            cin >> marks[i];

            if (marks[i] < 0 || marks[i] > 100)
                throw InvalidMarksException();

            total += marks[i];
        }

        average = (float)total / n;

        cout << "Total = " << total << endl;
        cout << "Average = " << average << endl;

        if (average >= 80)
            cout << "Grade = A";
        else if (average >= 60)
            cout << "Grade = B";
        else if (average >= 40)
            cout << "Grade = C";
        else
            cout << "Grade = F";
    }
    catch (InvalidMarksException e) {
        cout << "Exception: Invalid Marks";
    }

    return 0;
}
