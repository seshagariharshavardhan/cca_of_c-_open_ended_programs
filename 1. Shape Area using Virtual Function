#include <iostream>
using namespace std;

class Shape {
public:
    virtual void area() = 0;
};

class Circle : public Shape {
    float r;
public:
    void area() {
        cout << "Enter radius: ";
        cin >> r;
        cout << "Area of Circle = " << 3.14 * r * r;
    }
};

class Rectangle : public Shape {
    float l, b;
public:
    void area() {
        cout << "Enter length and breadth: ";
        cin >> l >> b;
        cout << "Area of Rectangle = " << l * b;
    }
};

int main() {
    Shape *s;
    Circle c;
    Rectangle r;
    int choice;

    cout << "1. Circle\n2. Rectangle\n";
    cout << "Enter choice: ";
    cin >> choice;

    if (choice == 1)
        s = &c;
    else
        s = &r;

    s->area();

    return 0;
}
