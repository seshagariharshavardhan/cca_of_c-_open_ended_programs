#include <iostream>
using namespace std;

template <class T>
void sortArray(T a[], int n) {
    T temp;

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    cout << "Sorted Array:\n";

    for (int i = 0; i < n; i++)
        cout << a[i] << " ";
}

int main() {
    int n, choice;

    cout << "1. Integer Array\n2. Float Array\n";
    cout << "Enter choice: ";
    cin >> choice;

    cout << "Enter size: ";
    cin >> n;

    if (n <= 0 || n > 100) {
        cout << "Invalid size";
        return 0;
    }

    if (choice == 1) {
        int a[100];

        cout << "Enter elements: ";
        for (int i = 0; i < n; i++)
            cin >> a[i];

        sortArray(a, n);
    }
    else if (choice == 2) {
        float a[100];

        cout << "Enter elements: ";
        for (int i = 0; i < n; i++)
            cin >> a[i];

        sortArray(a, n);
    }
    else {
        cout << "Invalid choice";
    }

    return 0;
}
