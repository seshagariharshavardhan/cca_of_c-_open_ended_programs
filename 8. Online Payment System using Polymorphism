#include <iostream>
using namespace std;

class Payment {
public:
    virtual void processPayment() = 0;
};

class UPIPayment : public Payment {
public:
    void processPayment() {
        float amount, rate;
        cout << "Enter Amount and Charge Percentage: ";
        cin >> amount >> rate;

        float charge = amount * rate / 100;

        cout << "Transaction Charge = " << charge << endl;
        cout << "Total Amount = " << amount + charge << endl;
        cout << "Payment Status = Successful";
    }
};

