int main() {
    Payment *p;
    UPIPayment u;
    CardPayment c;
    NetBankingPayment n;
    int choice;

    cout << "1. UPI\n2. Card\n3. Net Banking\n";
    cout << "Enter choice: ";
    cin >> choice;

    if (choice == 1)
        p = &u;
    else if (choice == 2)
        p = &c;
    else if (choice == 3)
        p = &n;
    else {
        cout << "Invalid choice";
        return 0;
    }

    p->processPayment();

    return 0;
}
